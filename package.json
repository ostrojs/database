{
    "name": "@ostro/database",
    "version": "2.0.0-alpha.13",
    "description": "Database module for OstroJS",
    "main": "databaseManager.js",
    "types": ".types/databaseManager.d.ts",
    "exports": {
        ".": {
            "types": "./.types/databaseManager.d.ts",
            "default": "./databaseManager.js"
        },
        "./*": {
            "types": "./.types/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && rm -rf build && npx tsc -p tsconfig.build.json && mkdir -p build/console/seeds/stubs build/console/factories/stubs build/migrations/stubs && cp src/console/seeds/stubs/* build/console/seeds/stubs/ && cp src/console/factories/stubs/* build/console/factories/stubs/ && cp src/migrations/stubs/* build/migrations/stubs/ && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest --runInBand --no-coverage --forceExit",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {
        "@ostro/console": "^2.0.0-alpha.10",
        "@ostro/contracts": "^2.0.0-alpha.9",
        "@ostro/pagination": "^2.0.0-alpha.8",
        "@ostro/support": "^2.0.0-alpha.10",
        "fs-extra": "^11.4.1",
        "knex": "^3.3.0",
        "lodash": "^4.17.21",
        "lodash.get": "^4.4.2",
        "sqlite3": "^6.0.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "database",
        "query builder",
        "model",
        "eloquent"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/database.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/database/issues"
    },
    "homepage": "https://github.com/ostrojs/database#readme",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.7",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
